FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    curl wget tar gzip jq build-essential file \
    && rm -rf /var/lib/apt/lists/*

# Install koxtoolchain for both kindlehf and kindlepw2
RUN wget -q https://github.com/KindleModding/koxtoolchain/releases/latest/download/kindlehf.tar.gz \
    -O - | tar -xzf - -C ~ && \
    wget -q https://github.com/KindleModding/koxtoolchain/releases/latest/download/kindlepw2.tar.gz \
    -O - | tar -xzf - -C ~

ENV PATH="/root/x-tools/arm-kindlehf-linux-gnueabihf/bin:/root/x-tools/arm-kindlepw2-linux-gnueabi/bin:$PATH"

# Create stub shared libraries with all required symbols (resolved at runtime on the Kindle)
RUN cat > /tmp/lipc_stub.c << 'EOF'
void* LipcOpenEx(const char* s, int* c) { return 0; }
void  LipcClose(void* l) {}
int   LipcRegisterStringProperty(void* l, const char* p, void* g, void* s, void* d) { return 0; }
int   LipcSetStringProperty(void* l, const char* svc, const char* p, const char* v) { return 0; }
int   LipcSetIntProperty(void* l, const char* svc, const char* p, int v) { return 0; }
int   LipcGetStringProperty(void* l, const char* svc, const char* p, char** v) { return 0; }
void  LipcFreeString(char* s) {}
EOF
RUN cat > /tmp/scanner_stub.c << 'EOF'
int   scanner_post_change(void* json) { return 0; }
void  scanner_gen_uuid(char* out, int size) {}
char* scanner_get_thumbnail_for_uuid(char* uuid) { return 0; }
void  scanner_update_ccat_entry_with_thumbpath(char* uuid, char* path) {}
void  scanner_delete_ccat_entry(char* uuid) {}
char* getSha1Hash(const char* data) { return 0; }
EOF
RUN HF=/root/x-tools/arm-kindlehf-linux-gnueabihf/arm-kindlehf-linux-gnueabihf/sysroot/usr/lib && \
    PW2=/root/x-tools/arm-kindlepw2-linux-gnueabi/arm-kindlepw2-linux-gnueabi/sysroot/usr/lib && \
    arm-kindlehf-linux-gnueabihf-gcc -shared -fPIC -o $HF/liblipc.so /tmp/lipc_stub.c && \
    arm-kindlehf-linux-gnueabihf-gcc -shared -fPIC -o $HF/libscanner.so /tmp/scanner_stub.c && \
    arm-kindlepw2-linux-gnueabi-gcc -shared -fPIC -o $PW2/liblipc.so /tmp/lipc_stub.c && \
    arm-kindlepw2-linux-gnueabi-gcc -shared -fPIC -o $PW2/libscanner.so /tmp/scanner_stub.c

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:$PATH"

# Add cross-compilation targets
RUN rustup target add armv7-unknown-linux-gnueabihf armv7-unknown-linux-gnueabi

WORKDIR /build
COPY . .

# kindlepw2 sysroot glibc 2.12 lacks getauxval (added in 2.16), and Kindle's
# libcjson.so lacks convenience add functions (pre-1.6.0); compile static stubs
RUN arm-kindlepw2-linux-gnueabi-gcc -c -o /tmp/getauxval_stub.o stubs/getauxval_stub.c && \
    arm-kindlehf-linux-gnueabihf-gcc -c -o /tmp/cjson_addboolfixup_hf.o stubs/cjson_addboolfixup.c && \
    arm-kindlepw2-linux-gnueabi-gcc -c -o /tmp/cjson_addboolfixup_pw2.o stubs/cjson_addboolfixup.c

# Build kindlehf with cjson compatibility stub
RUN RUSTFLAGS="-C link-arg=/tmp/cjson_addboolfixup_hf.o" cargo build-hf

# Build kindlepw2 with getauxval and cjson compatibility stubs
RUN RUSTFLAGS="-C link-arg=/tmp/getauxval_stub.o -C link-arg=/tmp/cjson_addboolfixup_pw2.o" cargo build-pw2

RUN VERSION=$(jq -r '.version | join(".")' kpm/manifest.json) && \
    rm -rf build dist && \
    mkdir dist && \
    mkdir -p build/kindlehf/bin build/kindlehf/lib && \
    mkdir -p build/kindlepw2/bin build/kindlepw2/lib && \
    cp kpm/install.sh kpm/install.sql kpm/manifest.json kpm/uninstall.sh kpm/uninstall.sql build/ && \
    cp target/armv7-unknown-linux-gnueabihf/release/kompanion_launcher build/kindlehf/bin/ && \
    cp target/armv7-unknown-linux-gnueabihf/release/libkompanion_extractor.so build/kindlehf/lib/ && \
    cp target/armv7-unknown-linux-gnueabi/release/kompanion_launcher build/kindlepw2/bin/ && \
    cp target/armv7-unknown-linux-gnueabi/release/libkompanion_extractor.so build/kindlepw2/lib/ && \
    (cd build && tar -czf ../dist/kompanion-${VERSION}.kpkg *) && \
    ls -la dist/ && \
    echo "=== kindlehf ===" && file build/kindlehf/bin/kompanion_launcher && \
    echo "=== kindlepw2 ===" && file build/kindlepw2/bin/kompanion_launcher
